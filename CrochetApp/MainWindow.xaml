<Window x:Class="CrochetApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CrochetApp"
        mc:Ignorable="d"        
        Title="TestApp Startup" Height="500" Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#FFFDEEF4">
    <Window.Resources>
        <Style x:Key="PinkButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="#FFF3CFE3"/>
            <Setter Property="Foreground" Value="#FF7A4E6D"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#FFDEB3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFEBD0E0"/>
                    <Setter Property="BorderBrush" Value="#FFB85C8B"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="#FFF8DFF0" CornerRadius="10" Padding="20" Margin="20" BorderBrush="#FFE3A6C0" BorderThickness="2">
            <StackPanel>
                <TextBlock Text="🌸 Welcome to TestApp 🌸"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#FFB85C8B"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <UniformGrid Columns="3" HorizontalAlignment="Center">
                    <Button Content="User" Click="ClassButton_Click" Style="{StaticResource PinkButtonStyle}"/>
                    <Button Content="Pattern" Click="ClassButton_Click" Style="{StaticResource PinkButtonStyle}"/>
                    <Button Content="Project" Click="ClassButton_Click" Style="{StaticResource PinkButtonStyle}"/>
                    <Button Content="Category" Click="ClassButton_Click" Style="{StaticResource PinkButtonStyle}"/>
                    <Button Content="Hook" Click="ClassButton_Click" Style="{StaticResource PinkButtonStyle}"/>
                    <Button Content="Image" Click="ClassButton_Click" Style="{StaticResource PinkButtonStyle}"/>
                    <Button Content="Library" Click="ClassButton_Click" Style="{StaticResource PinkButtonStyle}"/>
                    <Button Content="Request" Click="ClassButton_Click" Style="{StaticResource PinkButtonStyle}"/>
                    <Button Content="Suggestion" Click="ClassButton_Click" Style="{StaticResource PinkButtonStyle}"/>
                    <Button Content="Tag" Click="ClassButton_Click" Style="{StaticResource PinkButtonStyle}"/>
                    <Button Content="Technique" Click="ClassButton_Click" Style="{StaticResource PinkButtonStyle}"/>
                    <Button Content="Tutorial" Click="ClassButton_Click" Style="{StaticResource PinkButtonStyle}"/>
                    <Button Content="Yarn" Click="ClassButton_Click" Style="{StaticResource PinkButtonStyle}"/>
                </UniformGrid>
            </StackPanel>
        </Border>


    </Grid>
</Window>
