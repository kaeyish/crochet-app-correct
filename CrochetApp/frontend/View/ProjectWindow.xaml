<Window x:Class="CrochetApp.frontend.View.ProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CrochetApp.frontend.View"
        mc:Ignorable="d"
         Title="Project Manager" Height="500" Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#FFFDEEF4">
    <StackPanel>
        <TextBlock Text="Projects" FontSize="24" FontWeight="Bold" Foreground="#FF7A4E6D"
                   Grid.Row="0" HorizontalAlignment="Left" Margin="0,0,0,10"/>
        <ListBox ItemsSource="{Binding ProjectHierarchy}" HorizontalContentAlignment="Stretch" SelectedItem="{Binding SelectedProjectNode}" Background="#FFF8DFF0" BorderBrush="#FFDEB3C7" BorderThickness="1">
        <ListBox.ItemTemplate>
            <DataTemplate>
                <Border BorderBrush="#FFDEB3C7" BorderThickness="1" CornerRadius="6" Background="#FFF8DFF0" Margin="5" Padding="10">
                    <StackPanel>
                        <!-- Main Project -->
                        <TextBlock Text="{Binding Project.Name}" FontSize="18" FontWeight="Bold" Foreground="#FF7A4E6D" Margin="0,0,0,10"/>

                        <!-- Child Projects -->
                        <ItemsControl ItemsSource="{Binding Children}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="10,0,0,5" Foreground="#FF4E6D7A">
                                    <Run Text="↳  "/>
                                    <Run Text="{Binding Name}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                </Border>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Command="{Binding AddBaseProjectCommand}" Content="➕ Add Base Project" Width="150" Background="#FFDFF8E3" Margin="5"/>
            <Button Command="{Binding AddChildProjectCommand}" Content="➕ Add Child Project" Width="150" Background="#FFFDF3D6" Margin="5"/>
        </StackPanel>

    </StackPanel>

</Window>