<Window x:Class="CrochetApp.frontend.View.AddUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CrochetApp.frontend.View"
        mc:Ignorable="d"       
        Title="Add New User"
        Height="400" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#FFFDEEF4">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Add New User" FontSize="20" FontWeight="Bold" Foreground="#FF7A4E6D" Margin="0,0,0,10"/>

            <TextBox x:Name="UsernameBox" Text="Username" Margin="0,5"/>
            <TextBox x:Name="EmailBox" Text="Email" Margin="0,5"/>
            <TextBox x:Name="PasswordBox" Text="Password" Margin="0,5"/>
            <ComboBox x:Name="LevelBox" ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}" Margin="0,5"/>
            <ComboBox x:Name="RoleBox" ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" Margin="0,5"/>
            <TextBox x:Name="ImageUrlBox" Text="Image URL" Margin="0,5"/>

            <Button Content="Add User" Click="Save_Click" Background="#FFF3CFE3" BorderBrush="#FFB85C8B" Margin="0,10"/>
        </StackPanel>
    </Grid>

</Window>
