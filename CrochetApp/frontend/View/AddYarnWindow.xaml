<Window x:Class="CrochetApp.frontend.View.AddYarnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CrochetApp.frontend.View"
        mc:Ignorable="d"
        Title="Add New Yarn" 
        Height="400" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#FFFDEEF4">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Add New Yarn" FontSize="20" FontWeight="Bold" Foreground="#FF7A4E6D" Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Yarn Name:" Width="100" VerticalAlignment="Center"/>
                <TextBox x:Name="YarnNameBox" Width="300"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Type:" Width="100" VerticalAlignment="Center"/>
                <TextBox x:Name="TypeBox" Width="300"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Material:" Width="100" VerticalAlignment="Center"/>
                <TextBox x:Name="MaterialBox" Width="300"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Weight:" Width="100" VerticalAlignment="Center"/>
                <TextBox x:Name="WeightBox" Width="300"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Min Size:" Width="100" VerticalAlignment="Center"/>
                <TextBox x:Name="MinSizeBox" Width="300"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Max Size:" Width="100" VerticalAlignment="Center"/>
                <TextBox x:Name="MaxSizeBox" Width="300"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Color:" Width="100" VerticalAlignment="Center"/>
                <TextBox x:Name="ColorBox" Width="300"/>
            </StackPanel>

            <Button Content="✅ Add Yarn" Click="SaveYarn_Click" Background="#FFDFF8E3" Width="150" Margin="0,20,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
