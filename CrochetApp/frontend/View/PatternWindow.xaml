<Window x:Class="CrochetApp.frontend.View.PatternWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CrochetApp.frontend.View"
        mc:Ignorable="d"
       Title="Pattern Manager" Height="500" Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#FFFDEEF4">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Filters -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}" Width="120"/>
            <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus}" Width="120"/>
            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name" Width="120"/>
        </StackPanel>


        <ListBox Grid.Row="1"  ItemsSource="{Binding FilteredPatterns}" SelectedItem="{Binding SelectedPattern}" DisplayMemberPath="Title"
                 Background="#FFF8DFF0" BorderBrush="#FFDEB3C7" BorderThickness="1" Margin="0,0,0,10"/>



        <StackPanel Grid.Row="2" Margin="0,10,0,10" Background="#FFF3CFE3">
            <TextBlock Text="Selected Pattern Details" FontWeight="Bold" FontSize="16" Foreground="#FF7A4E6D" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Title: " FontWeight="Bold" Width="100"/>
                <TextBlock Text="{Binding SelectedPattern.Title}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Description: " FontWeight="Bold" Width="100"/>
                <TextBlock Text="{Binding SelectedPattern.Description}" TextWrapping="Wrap" Width="500"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Level: " FontWeight="Bold" Width="100"/>
                <TextBlock Text="{Binding SelectedPattern.Level}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Date: " FontWeight="Bold" Width="100"/>
                <TextBlock Text="{Binding SelectedPattern.Date}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Rating: " FontWeight="Bold" Width="100"/>
                <TextBlock Text="{Binding SelectedPattern.Rating}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Instructions: " FontWeight="Bold" Width="100"/>
                <TextBlock Text="{Binding SelectedPattern.Instructions}" TextWrapping="Wrap" Width="500"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Status: " FontWeight="Bold" Width="100"/>
                <TextBlock Text="{Binding SelectedPattern.Status}" />
            </StackPanel>

            <StackPanel Margin="0,10,0,0">
                <TextBlock Text="Photos:" FontWeight="Bold" FontSize="14" Foreground="#FF7A4E6D" Margin="0,0,0,5"/>
                <ItemsControl ItemsSource="{Binding PatternImages}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Image Source="{Binding}" Width="100" Height="100" Margin="5" Stretch="UniformToFill"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </StackPanel>


        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Command="{Binding AddCommand}" Content="➕ Add" Width="100" Background="#FFDFF8E3"/>
            <Button Command="{Binding UpdateCommand}" Content="✏️ Update" Width="100" Background="#FFFDF3D6"/>
            <Button Command="{Binding DeleteCommand}" Content="🗑️ Delete" Width="100" Background="#FFF8D8D8"/>
        </StackPanel>
    </Grid>
</Window>

