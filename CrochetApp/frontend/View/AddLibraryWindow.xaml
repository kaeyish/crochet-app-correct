<Window x:Class="CrochetApp.frontend.View.AddLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CrochetApp.frontend.View"
        mc:Ignorable="d"
       Title="Add Library" Height="500" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#FFFDEEF4">

    <StackPanel Margin="20">
        <TextBlock Text="Add New Library" FontSize="20" FontWeight="Bold" Foreground="#FF7A4E6D" Margin="0,0,0,20"/>

        <TextBox x:Name="NameBox" Text="Library Name" Margin="0,5"/>
        <TextBox x:Name="DescBox" Text="Library Description" Margin="0,5"/>

        <TextBlock Text="Select Patterns" FontWeight="Bold" Margin="0,20,0,5"/>
        <ListBox x:Name="PatternListBox" ItemsSource="{Binding AvailablePatterns}" SelectionMode="Multiple" DisplayMemberPath="Title" Height="200"/>

        <Button Content="✅ Save" Click="Save_Click" Background="#FFDFF8E3" Width="100" Margin="0,20,0,0"/>
    </StackPanel>
</Window>
