<Window x:Class="CrochetApp.frontend.View.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CrochetApp.frontend.View"
        mc:Ignorable="d"
        Title="Library Manager" Height="500" Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#FFFDEEF4">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox ItemsSource="{Binding Libraries}" HorizontalContentAlignment="Stretch" SelectedItem="{Binding SelectedLibrary}" Background="#FFF8DFF0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#FFDEB3C7" BorderThickness="1" CornerRadius="6" Margin="5" Padding="10">
                        <StackPanel>
                            <TextBlock Text="{Binding Library.Name}" FontSize="18" FontWeight="Bold" Foreground="#FF7A4E6D"/>
                            <TextBlock Text="{Binding Library.Description}" FontStyle="Italic" Margin="0,5,0,10"/>

                            <ItemsControl ItemsSource="{Binding Patterns}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="10,0,0,5" Foreground="#FF4E6D7A">
                                            <Run Text="• "/>
                                            <Run Text="{Binding Title}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Command="{Binding AddLibraryCommand}" Content="➕ Add Library" Width="150" Background="#FFDFF8E3" Margin="5"/>
            <Button Command="{Binding AddPatternToLibraryCommand}" Content="➕ Add Pattern to Library" Width="200" Background="#FFFDF3D6" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
