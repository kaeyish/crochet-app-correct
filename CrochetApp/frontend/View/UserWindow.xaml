<Window x:Class="CrochetApp.frontend.View.UserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CrochetApp.frontend.View"
        mc:Ignorable="d"        
        Title="User 🧶" Height="500" Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#FFFDEEF4">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- Filters -->
            <StackPanel Grid.Column ="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,10">
                <Label Content="Filters:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" Width="120"/>
                <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}" Width="120"/>
            </StackPanel>
            <!-- Commands -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,0,0,0">
                <Button Command="{Binding AddUserCommand}" Width="100" Height="40" Background="#FFDFF8E3" BorderBrush="#FF9ACF9A">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="➕" FontSize="16" Margin="0,0,5,0"/>
                        <TextBlock Text="Add" FontWeight="Bold"/>
                    </StackPanel>
                </Button>


                <Button Command="{Binding UpdateUserCommand}" Width="100" Height="40" Background="#FFFDF3D6" BorderBrush="#FFD8B85C">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="✏️" FontSize="16" Margin="0,0,5,0"/>
                        <TextBlock Text="Update" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding DeleteUserCommand}" Width="100" Height="40" Background="#FFF8D8D8" BorderBrush="#FFB85C5C">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🗑️" FontSize="16" Margin="0,0,5,0"/>
                        <TextBlock Text="Delete" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>    
            <!-- User List -->
        <ListBox Grid.Row="1" ItemsSource="{Binding FilteredUsers}" SelectedItem="{Binding SelectedUser}" DisplayMemberPath="Username"
                 Background="#FFF8DFF0" BorderBrush="#FFDEB3C7" BorderThickness="1" Margin="0,0,0,10" />

        <!-- Selected User Details -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0" Background="#FFF3CFE3">
            <TextBlock Text="Selected User Details" FontWeight="Bold" FontSize="16" Foreground="#FF7A4E6D" Margin="0,0,0,10"/>
            <Image Source="{Binding ProfilePic}" Width="100" Height="100" Margin="0,0,0,10"/> 
            <TextBlock Text="{Binding SelectedUser.Username}" />
            <TextBlock Text="{Binding SelectedUser.Email}" />
            <TextBlock Text="{Binding SelectedUser.Role}" />
            <TextBlock Text="{Binding SelectedUser.Level}" />
        </StackPanel>
    </Grid>

</Window>
