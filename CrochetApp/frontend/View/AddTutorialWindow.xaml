<Window x:Class="CrochetApp.frontend.View.AddTutorialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CrochetApp.frontend.View"
        mc:Ignorable="d"
         Title="Add Tutorial" Height="500" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#FFFDEEF4">

    <StackPanel Margin="20">
        <TextBlock Text="Add New Tutorial" FontSize="20" FontWeight="Bold" Foreground="#FF7A4E6D" Margin="0,0,0,20"/>

        <TextBox x:Name="TitleBox" Text="Title" Margin="0,5"/>
        <TextBox x:Name="DifficultyBox" Text="Difficulty" Margin="0,5"/>
        <TextBox x:Name="VideoBox" Text="Video URL" Margin="0,5"/>
        <TextBox x:Name="TextBox" Text="Tutorial Text" Margin="0,5"/>

        <TextBlock Text="Select Techniques" FontWeight="Bold" Margin="0,20,0,5"/>
        <ListBox x:Name="TechniqueListBox" ItemsSource="{Binding AvailableTechniques}" SelectionMode="Multiple" DisplayMemberPath="Name" Height="150"/>

        <Button Content="✅ Save" Click="Save_Click" Background="#FFDFF8E3" Width="100" Margin="0,20,0,0"/>
    </StackPanel>
</Window>
