<Window x:Class="CrochetApp.frontend.View.AddPatternToLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CrochetApp.frontend.View"
        mc:Ignorable="d"
        Title="Add Patterns to Library" Height="400" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#FFFDEEF4">

    <StackPanel Margin="20">
        <TextBlock Text="Select Patterns to Add" FontSize="20" FontWeight="Bold" Foreground="#FF7A4E6D" Margin="0,0,0,20"/>

        <ListBox x:Name="PatternListBox"
                 ItemsSource="{Binding AvailablePatterns}"
                 SelectionMode="Multiple"
                 DisplayMemberPath="Title"
                 Height="250"
                 Background="#FFF8DFF0"
                 BorderBrush="#FFDEB3C7"
                 BorderThickness="1"/>

        <Button Content="✅ Add Selected" Click="Save_Click" Background="#FFDFF8E3" Width="150" Margin="0,20,0,0"/>
    </StackPanel>
</Window>

