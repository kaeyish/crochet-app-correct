<Window x:Class="CrochetApp.frontend.View.UpdatePatternWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CrochetApp.frontend.View"
        mc:Ignorable="d"
    Title="Update Pattern" Height="450" Width="400"
    WindowStartupLocation="CenterScreen"
    Background="#FFFDEEF4">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Add New Pattern" FontSize="20" FontWeight="Bold" Foreground="#FF7A4E6D" Margin="0,0,0,10"/>

            <TextBox x:Name="TitleBox"/>
            <TextBox x:Name="DescBox"/>
            <ComboBox x:Name="LevelBox" ItemsSource="{Binding Levels}" SelectedIndex="0"/>
            <DatePicker x:Name="DateBox"/>
            <TextBox x:Name="RatingBox"/>
            <TextBox x:Name="InstBox"/>
            <ComboBox x:Name="StatusBox" ItemsSource="{Binding Statuses}" SelectedIndex="0"/>

            <Button Content="Add" Click="Save_Click" Background="#FFDFF8E3" Margin="0,10"/>
        </StackPanel>
    </Grid>
</Window>
