<Window x:Class="CrochetApp.frontend.View.UpdateUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CrochetApp.frontend.View"
        mc:Ignorable="d"
        Title="Update User" 
        Height="400" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#FFFDEEF4">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Update User Info" FontSize="20" FontWeight="Bold" Foreground="#FF7A4E6D" Margin="0,0,0,10"/>

            <TextBox x:Name="UsernameBox" Text="Username"/>
            <TextBox x:Name="PasswordBox" Text="Password"/>
            <ComboBox x:Name="LevelBox" ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}" />
            <ComboBox x:Name="RoleBox" ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" />
            <TextBox x:Name="ImageIdBox" Text="Image ID"/>

            <Button Content="Save Changes" Click="Save_Click" Background="#FFF3CFE3" BorderBrush="#FFB85C8B"/>
        </StackPanel>
    </Grid>

</Window>
