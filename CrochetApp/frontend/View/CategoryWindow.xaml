<Window x:Class="CrochetApp.frontend.View.CategoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CrochetApp.frontend.View"
        mc:Ignorable="d"
        Title="Category Manager" Height="500" Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#FFFDEEF4">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Text="Categories" FontSize="24" FontWeight="Bold" Foreground="#FF7A4E6D"
                   Grid.Row="0" HorizontalAlignment="Left" Margin="0,0,0,10"/>

        <!-- Category List -->
        <ListBox Grid.Row="1"  ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name"
         Background="#FFF8DFF0" BorderBrush="#FFDEB3C7" BorderThickness="1" Margin="0,0,0,10"/>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Command="{Binding AddCommand}" Content="➕ Add" Width="100" Background="#FFDFF8E3" BorderBrush="#FF9ACF9A" Margin="5"/>
            <Button Command="{Binding UpdateCommand}" Content="✏️ Update" Width="100" Background="#FFFDF3D6" BorderBrush="#FFD8B85C" Margin="5"/>
            <Button Command="{Binding DeleteCommand}" Content="🗑️ Delete" Width="100" Background="#FFF8D8D8" BorderBrush="#FFB85C5C" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>

