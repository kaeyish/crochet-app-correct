<Window x:Class="CrochetApp.frontend.View.TutorialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CrochetApp.frontend.View"
        mc:Ignorable="d"
        Title="Tutorials" Height="500" Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#FFFDEEF4">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox ItemsSource="{Binding Tutorials}" HorizontalContentAlignment="Stretch" Background="#FFF8DFF0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#FFDEB3C7" BorderThickness="1" CornerRadius="6" Margin="5" Padding="10">
                        <StackPanel>
                            <TextBlock Text="{Binding Tutorial.Title}" FontSize="18" FontWeight="Bold" Foreground="#FF7A4E6D"/>
                            <TextBlock Text="{Binding Tutorial.Level}" FontStyle="Italic" Margin="0,5,0,10"/>

                            <ItemsControl ItemsSource="{Binding Techniques}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="10,0,0,5" Foreground="#FF4E6D7A">
                                            <Run Text="• "/>
                                            <Run Text="{Binding Name}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="1" Command="{Binding AddTutorialCommand}" Content="➕ Add Tutorial" Width="150" Background="#FFDFF8E3" Margin="0,20,0,0" HorizontalAlignment="Center"/>
    </Grid>
</Window>
